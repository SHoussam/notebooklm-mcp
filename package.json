{
  "name": "notebooklm-mcp",
  "version": "2.1.0",
  "description": "MCP server for Google NotebookLM — chat, PDF/YouTube/URL/text source ingestion, notebook creation, Studio artifacts (Audio, Video, Mind Map, Slides, Reports, Flashcards/Quiz), citations, stdio + multi-session Streamable-HTTP transports.",
  "type": "module",
  "bin": {
    "notebooklm-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"import('node:fs').then(fs => fs.chmodSync('dist/index.js', 0o755))\"",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "prepare": "npm run build",
    "auth": "node dist/index.js auth",
    "auth:cookies": "node dist/index.js auth:cookies",
    "auth:token": "node dist/index.js auth:token",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "check": "npm run format:check && npm run lint && npm run build"
  },
  "keywords": [
    "mcp",
    "notebooklm",
    "gemini",
    "ai",
    "antigravity",
    "claude"
  ],
  "author": "SHoussam (fork of PleasePrompto/notebooklm-mcp)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHoussam/notebooklm-mcp.git"
  },
  "homepage": "https://github.com/SHoussam/notebooklm-mcp#readme",
  "bugs": {
    "url": "https://github.com/SHoussam/notebooklm-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "antigravity-plugin"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.0",
    "env-paths": "^3.0.0",
    "globby": "^14.1.0",
    "patchright": "^1.48.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
